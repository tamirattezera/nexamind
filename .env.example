# NexaMind environment configuration
# Never commit real credentials or production secrets.

# Django
DJANGO_SECRET_KEY=replace-with-a-secure-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Browser origins allowed to access the backend API.
# Set the production frontend origin in the production environment.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Production security
# Keep disabled for local HTTP development.
# Enable only after HTTPS is configured.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0

# PostgreSQL
DB_NAME=nexamind_db
DB_USER=nexamind_user
DB_PASSWORD=replace-with-your-database-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONNECT_TIMEOUT=2
HEALTH_CHECK_DB_STATEMENT_TIMEOUT_MS=2000

# Production shared cache (required when DJANGO_DEBUG=False)
REDIS_URL=redis://127.0.0.1:6379/1
REDIS_SOCKET_CONNECT_TIMEOUT=2
REDIS_SOCKET_TIMEOUT=2

# Gemini API
GEMINI_API_KEY=replace-with-your-api-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=LOW
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_TIMEOUT_MS=60000

# Conversation context policy
CHAT_CONTEXT_MAX_INPUT_TOKENS=32768
CHAT_MAX_MESSAGE_LENGTH=10000

# Generation rate limiting
CHAT_GENERATION_RATE_LIMIT=10
CHAT_GENERATION_RATE_WINDOW_SECONDS=60
